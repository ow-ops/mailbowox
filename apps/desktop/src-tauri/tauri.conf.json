{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mailbowox",
  "identifier": "eu.owops.mailbowox",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:8090",
    "beforeDevCommand": "pnpm --filter app exec expo start --port 8090",
    "beforeBuildCommand": "pnpm --filter app exec expo export -p web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mailbowox",
        "create": false,
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
