{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/ui": "~58.0.29",
    "@formatjs/intl-pluralrules": "^7.1.0",
    "@mailbowox/core-native": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react-native": "~8.28.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.108.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "i18next": "^27.1.5",
    "idb-keyval": "^6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "sonner": "^2.0.8",
    "sonner-native": "^0.27.0",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "native",
        "preset": "jest-expo",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|sonner-native|@noble))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "resolver": "<rootDir>/jest/resolver.js",
        "setupFilesAfterEnv": [
          "<rootDir>/jest/setup.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "-web-test\\.tsx?$"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|sonner-native|@noble))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "resolver": "<rootDir>/jest/resolver.js",
        "setupFilesAfterEnv": [
          "<rootDir>/jest/setup.js"
        ],
        "testMatch": [
          "<rootDir>/__tests__/**/*-web-test.ts?(x)"
        ]
      }
    ]
  }
}
